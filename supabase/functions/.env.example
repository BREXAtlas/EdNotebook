# Copy names into Supabase Edge Function secrets. Never commit real values.

# Comma-separated exact browser origins allowed by the Edge Functions.
ALLOWED_ORIGINS=https://ednotebook.com,https://www.ednotebook.com,https://brexatlas.github.io,http://localhost:5173,http://127.0.0.1:5173

# Comma-separated exact hostnames the server may fetch for link previews.
# Fail-closed when unset. Only add domains controlled by or explicitly trusted
# by the operator; add any separate image/CDN host if its preview image is used.
LINK_PREVIEW_ALLOWED_HOSTS=ednotebook.com,www.ednotebook.com

# Independent random values; generate at least 32 random bytes for each.
AUDIT_HASH_SALT=replace-with-a-random-audit-salt
DOCUMENT_SECURITY_WORKER_TOKEN=replace-with-a-random-worker-token
RETENTION_CRON_SECRET=replace-with-a-random-retention-secret

# Public HTTPS origin of the always-on scanner/conversion container.
DOCUMENT_SECURITY_WORKER_URL=https://worker.example.com

# LiveKit Cloud values used only by the live-room-session Edge Function.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-your-livekit-api-key
LIVEKIT_API_SECRET=replace-with-your-livekit-api-secret

# Server-side Stripe values. Never prefix these with VITE_.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_PRICE_PROFESSOR=price_replace_me
STRIPE_PRICE_INSTITUTION=price_replace_me
STRIPE_PRICE_ENTERPRISE=price_replace_me
